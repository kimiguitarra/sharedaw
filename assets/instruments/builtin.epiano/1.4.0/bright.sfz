// 1.4.0: オクターブ上の倍音の音程のずれ（デチューン）をなくし、トレモロを浅くした（スマホで鳴らしたときのうねりを減らす）
// 1.3.0: 鍵盤（MIDI ノート）を離したら短く切れる（リリース 0.08 秒。メロディ向けにタイトに）
// 明るめのエレピ: 倍音と打鍵音を強めにして、バンドの中でも埋もれにくくしたもの
<group> group_volume=-2 lokey=0 hikey=127 amp_keycenter=60 amp_keytrack=-0.25 ampeg_release=0.08
 amplfo_freq=5 amplfo_depth=0.4
<region> sample=*sine volume=0 pan=-15 amp_veltrack=75
 ampeg_attack=0.003 ampeg_hold=0.02 ampeg_decay=3.5 ampeg_sustain=28
<region> sample=*sine transpose=12 volume=-9 pan=15 amp_veltrack=100 amp_velcurve_127=1 amp_velcurve_1=0.1
 ampeg_attack=0.002 ampeg_decay=1.1 ampeg_sustain=10
<region> sample=*triangle transpose=19 volume=-22 amp_veltrack=100 amp_velcurve_127=1 amp_velcurve_1=0.05
 ampeg_attack=0.001 ampeg_decay=0.45 ampeg_sustain=2
<region> sample=*sine transpose=40 tune=-14 volume=-22 amp_veltrack=100 amp_velcurve_127=1 amp_velcurve_1=0.05
 ampeg_attack=0 ampeg_decay=0.09 ampeg_sustain=0 ampeg_release=0.05
